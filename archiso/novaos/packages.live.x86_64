# Stage 1 - install on the live ISO's airootfs only (not copied to target)
# Slimmed: removed heavy recovery tools (clonezilla, testdisk, photorec, gpart),
# duplicate Pacman helpers, deepin-anything (pulls Qt5 deps), samba (heavy).
################################################################################

## --- archiso-specific (live medium only) ---
archiso
archiso-initramfs
booster
archinstall

## --- Live-ISO tools (essentials only) ---
memtest86+
edk2-shell
partclone
secure-delete
ntfs-3g-system-compression
mc
p7zip
unrar
unzip
zip
xz
lz4
zstd
cabextract
cpio
dconf
gsettings-desktop-schemas
# clonezilla, testdisk, photorec, gpart, partimage, mc-hint,
# gconf, dconf-editor -> install on demand from NovaOS Store

## --- Hardware probing for NovaOS first-boot service ---
hwinfo
inxi
dmidecode
lshw
lscpu
lsblk
lspci
lsusb
smartmontools
util-linux
usbutils
pciutils
acpid
acpi
upower
lm_sensors
fwupd
mdadm
