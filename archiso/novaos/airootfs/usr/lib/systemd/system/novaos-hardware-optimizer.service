[Unit]
Description=NovaOS Hardware Optimizer Daemon
After=network.target
Wants=novaos-resource-maximizer.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/novaos-hardware-optimizer.py
Restart=always
RestartSec=5
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

[Install]
WantedBy=multi-user.target
